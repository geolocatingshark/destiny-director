{
  "comment": "Classic (content + embeds) snapshots — the shape a non-CV2 mirror capture carries.",
  "cases": [
    {
      "name": "content_only",
      "render": "snapshot",
      "kind": "classic",
      "payload": {
        "content": "## Heads up\nA plain message with **bold**."
      },
      "expected_html": "<div class=\"cv2-root classic\"><div class=\"cv2-note\">Classic message — text</div><div class=\"cv2-text\"><span class=\"md-h2\">Heads up</span>\nA plain message with <strong>bold</strong>.</div></div>"
    },
    {
      "name": "empty_message",
      "render": "snapshot",
      "kind": "classic",
      "payload": {
        "content": "",
        "embeds": []
      },
      "expected_html": "<div class=\"cv2-root classic\"><div class=\"cv2-note\">Classic message — empty message</div></div>"
    },
    {
      "name": "embed_full",
      "render": "snapshot",
      "kind": "classic",
      "payload": {
        "content": "see below",
        "embeds": [
          {
            "author": {
              "name": "Destiny Director"
            },
            "title": "**Xur** is here",
            "description": "Selling *things* at [the Tower](https://example.com/t).",
            "color": 15844367,
            "fields": [
              {
                "name": "Weapon",
                "value": "Hawkmoon",
                "inline": true
              },
              {
                "name": "Armour",
                "value": "- Helmet\n- Gauntlets"
              }
            ],
            "image": {
              "url": "https://example.com/xur.png"
            },
            "footer": {
              "text": "Leaves at reset"
            }
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root classic\"><div class=\"cv2-note\">Classic message — text · 1 embed(s)</div><div class=\"cv2-text\">see below</div><div class=\"cv2-embed\" style=\"border-left-color:#f1c40f\"><div class=\"embed-author\">Destiny Director</div><div class=\"embed-title\"><strong>Xur</strong> is here</div><div class=\"embed-desc\"><div class=\"cv2-text\">Selling <em>things</em> at <a href=\"https://example.com/t\">the Tower</a>.</div></div><div class=\"embed-field\"><div class=\"embed-field-name\">Weapon</div><div class=\"embed-field-value\"><div class=\"cv2-text\">Hawkmoon</div></div></div><div class=\"embed-field\"><div class=\"embed-field-name\">Armour</div><div class=\"embed-field-value\"><div class=\"cv2-text\"><span class=\"md-bullet\">Helmet</span>\n<span class=\"md-bullet\">Gauntlets</span></div></div></div><img class=\"embed-image\" src=\"https://example.com/xur.png\" alt=\"embed image\"><div class=\"embed-footer\">Leaves at reset</div></div></div>"
    },
    {
      "name": "embed_thumbnail_fallback",
      "render": "snapshot",
      "kind": "classic",
      "payload": {
        "embeds": [
          {
            "title": "Only a thumbnail",
            "thumbnail": {
              "url": "https://example.com/thumb.png"
            }
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root classic\"><div class=\"cv2-note\">Classic message — 1 embed(s)</div><div class=\"cv2-embed\"><div class=\"embed-title\">Only a thumbnail</div><img class=\"embed-image\" src=\"https://example.com/thumb.png\" alt=\"embed image\"></div></div>"
    },
    {
      "name": "embed_minimal",
      "render": "snapshot",
      "kind": "classic",
      "payload": {
        "embeds": [
          {
            "description": "just a description"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root classic\"><div class=\"cv2-note\">Classic message — 1 embed(s)</div><div class=\"cv2-embed\"><div class=\"embed-desc\"><div class=\"cv2-text\">just a description</div></div></div></div>"
    },
    {
      "name": "two_embeds",
      "render": "snapshot",
      "kind": "classic",
      "payload": {
        "content": "",
        "embeds": [
          {
            "title": "First"
          },
          {
            "title": "Second",
            "color": 3066993
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root classic\"><div class=\"cv2-note\">Classic message — 2 embed(s)</div><div class=\"cv2-embed\"><div class=\"embed-title\">First</div></div><div class=\"cv2-embed\" style=\"border-left-color:#2ecc71\"><div class=\"embed-title\">Second</div></div></div>"
    },
    {
      "name": "classic_truncated",
      "render": "snapshot",
      "kind": "classic",
      "payload": {
        "truncated": true
      },
      "expected_html": "<div class=\"cv2-placeholder\">⚠️ This version&#x27;s snapshot was too large to store in full.</div>"
    }
  ]
}
