      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-section\"><div class=\"cv2-section-body\"><div class=\"cv2-text\"><span class=\"md-h2\">Heading beside art</span></div><div class=\"cv2-text\">second line</div></div><div class=\"cv2-accessory\"><img class=\"cv2-thumb\" src=\"https://example.com/thumb.png\" alt=\"a described thumbnail\"></div></div></div>"
    },
