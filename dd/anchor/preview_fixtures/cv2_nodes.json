{
  "comment": "One case per CV2 node kind, rendered as a captured snapshot (CDN emoji).",
  "cases": [
    {
      "name": "text_block_prefixes",
      "render": "snapshot",
      "kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "# Title\n## Section\n### Sub\n-# small print\n- a bullet\nplain line"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-text\"><span class=\"md-h1\">Title</span>\n\n<span class=\"md-h2\">Section</span>\n\n<span class=\"md-h3\">Sub</span>\n<span class=\"md-small\">small print</span>\n<span class=\"md-bullet\">a bullet</span>\nplain line</div></div>"
    },
    {
      "name": "text_heading_spacing_normalised",
      "render": "snapshot",
      "kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "intro\n\n\n## Heading\n\nbody after"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-text\">intro\n\n<span class=\"md-h2\">Heading</span>\nbody after</div></div>"
    },
    {
      "name": "text_inline_markdown",
      "render": "snapshot",
      "kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "***both*** and **bold** and *italic* and [a link](https://example.com/x) and `code`"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-text\"><strong><em>both</em></strong> and <strong>bold</strong> and <em>italic</em> and <a href=\"https://example.com/x\" target=\"_blank\" rel=\"noopener noreferrer\">a link</a> and <code>code</code></div></div>"
    },
    {
      "name": "text_timestamps_absolute",
      "render": "snapshot",
      "kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "t=<t:1785430800:t> T=<t:1785430800:T> d=<t:1785430800:d> D=<t:1785430800:D> f=<t:1785430800:f> F=<t:1785430800:F>"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-text\">t=5:00 PM (UTC) T=5:00:00 PM (UTC) d=07/30/2026 D=July 30, 2026 f=Jul 30, 2026 5:00 PM (UTC) F=Jul 30, 2026 5:00 PM (UTC)</div></div>"
    },
    {
      "name": "text_timestamp_relative",
      "render": "snapshot",
      "kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "future=<t:1785690000:R> past=<t:1785344400:R> soon=<t:1785434400:R>"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-text\">future=in 3 days past=1 day ago soon=in 1 hour</div></div>"
    },
    {
      "name": "text_captured_emoji",
      "render": "snapshot",
      "kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "static <:kyber:1234567890> animated <a:spin:9876543210> unknown :nosuch:"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-text\">static <img class=\"emoji\" src=\"https://cdn.discordapp.com/emojis/1234567890.png\" alt=\":kyber:\"> animated <img class=\"emoji\" src=\"https://cdn.discordapp.com/emojis/9876543210.gif\" alt=\":spin:\"> unknown :nosuch:</div></div>"
    },
    {
      "name": "container_with_accent",
      "render": "snapshot",
      "kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 17,
            "accent_color": 15483557,
            "components": [
              {
                "type": 10,
                "content": "inside the card"
              }
            ]
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-container\" style=\"border-left-color:#ec42a5\"><div class=\"cv2-text\">inside the card</div></div></div>"
    },
