      "annotated": {
        "mode": "diff",
        "kind": "cv2",
        "note": null,
        "components": [
          {
            "type": 10,
            "content": "## Weekly reset\n- **Nightfall**: Warden\n- Crucible: Control",
            "_lines": [
              {
                "op": "equal",
                "line": "## Weekly reset"
              },
              {
                "op": "equal",
                "line": "- **Nightfall**: Warden"
              },
              {
                "op": "replace",
                "runs": [
                  {
                    "op": "equal",
                    "text": "- Crucible: "
                  },
                  {
                    "op": "del",
                    "text": "Clash"
                  },
                  {
                    "op": "ins",
                    "text": "Control"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
