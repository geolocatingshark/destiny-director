{
  "comment": "The mirror-log diff. These pin the five behaviours a naive annotation schema loses: equal lines keep their markdown, inserted lines render markdown inside <ins>, deleted lines are RAW escaped text inside <del>, a replace-run word-diffs the raw block, and the section accessory has a three-state.",
  "cases": [
    {
      "name": "diff_no_change",
      "render": "diff",
      "kind": "cv2",
      "old_kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "unchanged"
          }
        ]
      },
      "old_payload": {
        "components": [
          {
            "type": 10,
            "content": "unchanged"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-note\">No changes from the previous version.</div><div class=\"cv2-root\"><div class=\"cv2-text\">unchanged</div></div>",
      "annotated": {
        "mode": "diff",
        "kind": "cv2",
        "note": "No changes from the previous version.",
        "components": [
          {
            "type": 10,
            "content": "unchanged"
          }
        ]
      }
    },
    {
      "name": "diff_node_added",
      "render": "diff",
      "kind": "cv2",
      "old_kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "first"
          },
          {
            "type": 10,
            "content": "second"
          }
        ]
      },
      "old_payload": {
        "components": [
          {
            "type": 10,
            "content": "first"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-text\">first</div><div class=\"cv2-added\"><div class=\"cv2-text\">second</div></div></div>",
      "annotated": {
        "mode": "diff",
        "kind": "cv2",
        "note": null,
        "components": [
          {
            "type": 10,
            "content": "first"
          },
          {
            "type": 10,
            "content": "second",
            "_mark": "added"
          }
        ]
      }
    },
    {
      "name": "diff_node_removed",
      "render": "diff",
      "kind": "cv2",
      "old_kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "first"
          }
        ]
      },
      "old_payload": {
        "components": [
          {
            "type": 10,
            "content": "first"
          },
          {
            "type": 10,
            "content": "second"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-text\">first</div><div class=\"cv2-removed\"><div class=\"cv2-text\">second</div></div></div>",
      "annotated": {
        "mode": "diff",
        "kind": "cv2",
        "note": null,
        "components": [
          {
            "type": 10,
            "content": "first"
          },
          {
            "type": 10,
            "content": "second",
            "_mark": "removed"
          }
        ]
      }
    },
    {
      "name": "diff_text_word_level_edit",
      "render": "diff",
      "kind": "cv2",
      "old_kind": "cv2",
      "payload": {
        "components": [
          {
            "type": 10,
            "content": "Nightfall is The Corrupted"
          }
        ]
      },
      "old_payload": {
        "components": [
          {
            "type": 10,
            "content": "Nightfall is The Arms Dealer"
          }
        ]
      },
      "expected_html": "<div class=\"cv2-root\"><div class=\"cv2-text\">Nightfall is The <del>Arms Dealer</del><ins>Corrupted</ins></div></div>",
      "annotated": {
        "mode": "diff",
        "kind": "cv2",
        "note": null,
        "components": [
          {
            "type": 10,
            "content": "Nightfall is The Corrupted",
            "_lines": [
              {
                "op": "replace",
                "runs": [
                  {
                    "op": "equal",
                    "text": "Nightfall is The "
                  },
                  {
                    "op": "del",
                    "text": "Arms Dealer"
                  },
                  {
                    "op": "ins",
                    "text": "Corrupted"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
