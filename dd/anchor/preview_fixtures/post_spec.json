{
  "comment": "The flat .post-* previewer (weekly reset / trials / rotation wall). Phase 4 retires this vocabulary in favour of rendering the real build_cv2 node tree, so these expectations exist to prove the replacement shows the same post — not to be preserved verbatim.",
  "emoji": {
    "kyber": "https://cdn.discordapp.com/emojis/1234567890.png"
  },
  "cases": [
    {
      "name": "body_only",
      "render": "post_spec",
      "spec": {
        "body": "# Weekly reset\n\n## Nightfall\n\n- **Warden of Nothing**"
      },
      "expected_html": "<span class=\"md-h1\">Weekly reset</span>\n\n<span class=\"md-h2\">Nightfall</span>\n<span class=\"md-bullet\"><strong>Warden of Nothing</strong></span>"
    },
    {
      "name": "body_with_image",
      "render": "post_spec",
      "spec": {
        "body": "## Trials of Osiris",
        "image_url": "https://example.com/trials.png"
      },
      "expected_html": "<span class=\"md-h2\">Trials of Osiris</span>\n\n<img class=\"post-image\" src=\"https://example.com/trials.png\" alt=\"post image\">"
    },
    {
      "name": "body_with_buttons",
      "render": "post_spec",
      "spec": {
        "body": "Rotation update :kyber:",
        "buttons": [
          [
            "Website",
            "https://example.com/site"
          ],
          [
            "Support",
            "https://example.com/support"
          ]
        ]
      },
      "expected_html": "Rotation update <img class=\"emoji\" src=\"https://cdn.discordapp.com/emojis/1234567890.png\" alt=\":kyber:\">\n<div class=\"post-buttons\"><a class=\"post-button\" href=\"https://example.com/site\" target=\"_blank\" rel=\"noopener noreferrer\">Website</a><a class=\"post-button\" href=\"https://example.com/support\" target=\"_blank\" rel=\"noopener noreferrer\">Support</a></div>"
    },
    {
      "name": "buttons_drop_non_http",
      "render": "post_spec",
      "spec": {
        "body": "check the links",
        "buttons": [
          [
            "Fine",
            "https://example.com/ok"
          ],
          [
            "Dropped",
            "javascript:alert(1)"
          ]
        ]
      },
      "expected_html": "check the links\n<div class=\"post-buttons\"><a class=\"post-button\" href=\"https://example.com/ok\" target=\"_blank\" rel=\"noopener noreferrer\">Fine</a></div>"
    },
    {
      "name": "image_dropped_when_not_http",
      "render": "post_spec",
      "spec": {
        "body": "no image should render",
        "image_url": "ftp://x/y.png"
      },
      "expected_html": "no image should render"
    },
    {
      "name": "everything",
      "render": "post_spec",
      "spec": {
        "body": "# Title\n\n## Sub\n\nBody with :kyber: and <t:1785430800:f> and [a link](https://example.com/l).",
        "image_url": "https://example.com/hero.png",
        "buttons": [
          [
            "Open",
            "https://example.com/open"
          ]
        ]
      },
      "expected_html": "<span class=\"md-h1\">Title</span>\n\n<span class=\"md-h2\">Sub</span>\nBody with <img class=\"emoji\" src=\"https://cdn.discordapp.com/emojis/1234567890.png\" alt=\":kyber:\"> and Jul 30, 2026 5:00 PM (UTC) and <a href=\"https://example.com/l\">a link</a>.\n\n<img class=\"post-image\" src=\"https://example.com/hero.png\" alt=\"post image\">\n<div class=\"post-buttons\"><a class=\"post-button\" href=\"https://example.com/open\" target=\"_blank\" rel=\"noopener noreferrer\">Open</a></div>"
    }
  ]
}
